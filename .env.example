# Server-only Groq settings. Keep the provider account on its Free plan.
GROQ_API_KEY=
GROQ_FREE_PLAN=true

# Hosted AI also requires trusted sign-in and the DB binding/migrations.
# No payment or subscription credentials are needed.

# Separate email/password accounts; both values come from your Supabase project.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# No secret/service_role key is used. Account actions also need the DB binding.

# Enable only after confirmation URLs and email delivery have been configured.
SUPABASE_AUTH_READY=false
